+template <ushort NT>
+inline void mat_vec_q8_0_f32_lcpp_token_tiled(
+        constant mat_vec_q8_0_tiled_args & args,
+        device const uchar               * weight,
+        device const float               * x,
+        device       float               * y,
+        threadgroup  float               * shmem,
+        uint3  tgpig,
+        ushort sgitg,
+        ushort tiisg) {
+    constexpr ushort NW = 32;
+    constexpr ushort NQ = NQ_Q80;
+    constexpr ushort NR0 = NR0_Q80_LCPP;
+    constexpr ushort NSG = NSG_Q80_LCPP;
+
+    const uint first_row = tgpig.x * NR0;
+    const uint first_token = tgpig.y * NT;
+    if (first_row >= args.n_out || first_token >= args.n_tokens) return;
+
+    weight += (ulong)tgpig.z * args.weight_group_stride_bytes;
+    x += (ulong)tgpig.z * args.x_group_stride;
+    y += (ulong)tgpig.z * args.y_group_stride;
+
+    const uint nb = args.n_in / QK8_0;
+    const ushort ix = tiisg / (NW / NQ);
+    const ushort il = tiisg % (NW / NQ);
+    const uint ib0 = sgitg * NQ + ix;
+    const ulong row_stride_bytes = (ulong)nb * Q8_0_BYTES;
+    device const uchar * row0 = weight + (ulong)first_row * row_stride_bytes;
+
+    float sumf[NT][NR0];
+    for (ushort token = 0; token < NT; ++token) {
+        for (ushort row = 0; row < NR0; ++row) {
+            sumf[token][row] = 0.0f;
+        }
+    }
+
+    for (uint ib = ib0; ib < nb; ib += NSG * NQ) {
+        for (ushort row = 0; row < NR0; ++row) {
+            if (first_row + row >= args.n_out) break;
+            device const uchar * blk = row0
+                + (ulong)row * row_stride_bytes
+                + (ulong)ib * Q8_0_BYTES;
+            device const half   * dh = (device const half *)blk;
+            device const int8_t * qs = (device const int8_t *)(blk + 2) + il * NQ;
+            float qv[NQ];
+            for (ushort i = 0; i < NQ; ++i) {
+                qv[i] = (float)qs[i];
+            }
+            const float scale = (float)dh[0];
+
+            for (ushort token = 0; token < NT; ++token) {
+                const uint token_index = first_token + token;
+                if (token_index >= args.n_tokens) break;
+                device const float * xb = x
+                    + (ulong)token_index * args.x_token_stride
+                    + (ulong)ib * QK8_0
+                    + (ulong)il * NQ;
+                float sumq = 0.0f;
+                for (ushort i = 0; i < NQ; ++i) {
+                    sumq += qv[i] * xb[i];
+                }
+                sumf[token][row] += sumq * scale;
+            }
+        }
+    }
+
+    for (ushort token = 0; token < NT; ++token) {
+        for (ushort row = 0; row < NR0; ++row) {
+            threadgroup float * row_shmem =
+                shmem + ((ulong)token * NR0 + row) * NW;
+            if (sgitg == 0) {
+                row_shmem[tiisg] = 0.0f;
+            }
+            sumf[token][row] = simd_sum(sumf[token][row]);
+        }
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    for (ushort token = 0; token < NT; ++token) {
+        for (ushort row = 0; row < NR0; ++row) {
+            threadgroup float * row_shmem =
+                shmem + ((ulong)token * NR0 + row) * NW;
+            if (tiisg == 0) {
+                row_shmem[sgitg] = sumf[token][row];
+            }
+        }
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    for (ushort token = 0; token < NT; ++token) {
+        const uint token_index = first_token + token;
+        if (token_index >= args.n_tokens) break;
+        for (ushort row = 0; row < NR0 && first_row + row < args.n_out; ++row) {
+            threadgroup float * row_shmem =
+                shmem + ((ulong)token * NR0 + row) * NW;
+            const float total = simd_sum(row_shmem[tiisg]);
+            if (tiisg == 0 && sgitg == 0) {
+                y[(ulong)token_index * args.y_token_stride + first_row + row] = total;
+            }
+        }
+    }
+}
+
+kernel void kernel_mat_vec_q8_0_f32_lcpp_t4(
+        constant mat_vec_q8_0_tiled_args & args   [[buffer(0)]],
+        device const uchar               * weight [[buffer(1)]],
+        device const float               * x      [[buffer(2)]],
+        device       float               * y      [[buffer(3)]],
+        threadgroup  float               * shmem  [[threadgroup(0)]],
+        uint3  tgpig [[threadgroup_position_in_grid]],
+        ushort sgitg [[simdgroup_index_in_threadgroup]],
+        ushort tiisg [[thread_index_in_simdgroup]]) {
+    mat_vec_q8_0_f32_lcpp_token_tiled<4>(
+        args, weight, x, y, shmem, tgpig, sgitg, tiisg);
+}
+
+kernel void kernel_mat_vec_q8_0_f32_lcpp_t8(
+        constant mat_vec_q8_0_tiled_args & args   [[buffer(0)]],
+        device const uchar               * weight [[buffer(1)]],
+        device const float               * x      [[buffer(2)]],
+        device       float               * y      [[buffer(3)]],
+        threadgroup  float               * shmem  [[threadgroup(0)]],
+        uint3  tgpig [[threadgroup_position_in_grid]],
+        ushort sgitg [[simdgroup_index_in_threadgroup]],
+        ushort tiisg [[thread_index_in_simdgroup]]) {
+    mat_vec_q8_0_f32_lcpp_token_tiled<8>(
+        args, weight, x, y, shmem, tgpig, sgitg, tiisg);
+}
 
