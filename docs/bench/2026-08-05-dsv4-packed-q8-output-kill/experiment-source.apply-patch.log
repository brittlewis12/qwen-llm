+        let mut bucket_slots = host_read_i32(&self.bucket_slots, "packed decision bucket slots")?;
+        expert_ids.truncate(route_count);
+        weights.truncate(route_count);
+        bucket_rows.truncate(route_count);
+        bucket_slots.truncate(route_count);
