+    pub(super) len: usize,
+}
+
+#[cfg(all(test, feature = "dsv4-diagnostics"))]
+#[derive(Clone, Debug, PartialEq)]
+pub(super) struct PackedPrefillDecisionLayer {
+    pub(super) chunk_start: u32,
+    pub(super) n_tokens: usize,
+    pub(super) layer: usize,
+    pub(super) attention_kind: AttentionKind,
+    pub(super) sparse_query_offset: Option<usize>,
+    pub(super) route_source: PackedPrefillRouteSourceKind,
+    pub(super) expert_ids: Vec<i32>,
+    pub(super) weights: Vec<f32>,
+    pub(super) bucket_rows: Vec<i32>,
+    pub(super) bucket_slots: Vec<i32>,
+    pub(super) buckets: Vec<PackedPrefillExpertBucket>,
+    pub(super) learned_cutoff_margins: Vec<f32>,
+}
+
+#[cfg(all(test, feature = "dsv4-diagnostics"))]
+#[derive(Clone, Debug, Default, PartialEq)]
+pub(super) struct PackedPrefillDecisionCapture {
+    pub(super) layers: Vec<PackedPrefillDecisionLayer>,
+}
+
+#[cfg(all(test, feature = "dsv4-diagnostics"))]
+impl PackedPrefillDecisionCapture {
+    pub(super) fn new() -> Self {
+        Self {
+            layers: Vec::with_capacity(DEEPSEEK_V4_LAYER_COUNT * 2),
+        }
+    }
+
+    fn push(&mut self, record: PackedPrefillDecisionLayer) -> Result<(), DeepSeekV4MetalError> {
+        if let Some(previous) = self.layers.last() {
+            let same_chunk = previous.chunk_start == record.chunk_start;
+            let ordered = if same_chunk {
+                record.n_tokens == previous.n_tokens && record.layer == previous.layer + 1
+            } else {
+                record.layer == 0
+                    && record.chunk_start
+                        == previous
+                            .chunk_start
+                            .checked_add(previous.n_tokens as u32)
+                            .ok_or_else(|| {
+                                DeepSeekV4MetalError::Invalid(
+                                    "packed decision chunk position overflow".into(),
+                                )
+                            })?
+            };
+            if !ordered {
+                return invalid("packed decision records are not in chunk/layer order");
+            }
+        } else if record.layer != 0 {
+            return invalid("packed decision capture must begin at layer zero");
+        }
+        self.layers.push(record);
+        Ok(())
+    }
+}
