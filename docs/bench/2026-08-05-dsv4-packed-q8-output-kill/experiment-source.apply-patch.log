+#[derive(Clone, Copy, Debug)]
+pub struct MatVecQ8TokenTiledConfig {
+    pub n_in: usize,
+    pub n_out: usize,
+    pub n_tokens: usize,
+    pub token_tile: usize,
+    pub group_count: usize,
+    pub x_token_stride: usize,
+    pub y_token_stride: usize,
+    pub x_group_stride: usize,
+    pub y_group_stride: usize,
+}
+
+pub fn encode_mat_vec_q8_0_token_tiled_f32(
+    ctx: &MetalContext,
+    enc: &KernelEncoder,
+    weight: &MetalTensor,
+    x: &MetalTensor,
+    y: &MetalTensor,
+    config: MatVecQ8TokenTiledConfig,
+) -> Result<(), MetalError> {
+    let kernel = "mat_vec_q8_0_token_tiled";
+    let MatVecQ8TokenTiledConfig {
+        n_in,
+        n_out,
+        n_tokens,
+        token_tile,
+        group_count,
+        x_token_stride,
+        y_token_stride,
+        x_group_stride,
+        y_group_stride,
+    } = config;
+    let bad_shape = |detail: String| MetalError::BadShape { kernel, detail };
+    if n_in == 0
+        || n_out == 0
+        || n_tokens == 0
+        || group_count == 0
+        || !n_in.is_multiple_of(32)
+        || !matches!(token_tile, 4 | 8)
+    {
+        return Err(bad_shape(format!(
+            "requires nonzero dimensions/groups, n_in divisible by 32, and token_tile 4 or 8; got n_in={n_in} n_out={n_out} n_tokens={n_tokens} groups={group_count} tile={token_tile}"
+        )));
+    }
+    let weight_rows = n_out
+        .checked_mul(group_count)
+        .ok_or_else(|| bad_shape("weight row count overflow".into()))?;
+    let x_group_end = (group_count - 1)
+        .checked_mul(x_group_stride)
+        .and_then(|offset| offset.checked_add(n_in))
+        .ok_or_else(|| bad_shape("input group range overflow".into()))?;
+    let y_group_end = (group_count - 1)
+        .checked_mul(y_group_stride)
+        .and_then(|offset| offset.checked_add(n_out))
+        .ok_or_else(|| bad_shape("output group range overflow".into()))?;
+    let row_bytes = (n_in / 32)
+        .checked_mul(34)
+        .ok_or_else(|| bad_shape("Q8_0 row byte count overflow".into()))?;
+    let weight_group_stride_bytes = row_bytes
+        .checked_mul(n_out)
+        .ok_or_else(|| bad_shape("Q8_0 group byte stride overflow".into()))?;
+    let fits_buffer = |tensor: &MetalTensor| {
+        tensor
+            .offset
+            .checked_add(tensor.n_bytes())
+            .is_some_and(|end| end <= tensor.buffer.length() as u64)
+    };
+    if weight.dtype != GgmlType::Q8_0
+        || x.dtype != GgmlType::F32
+        || y.dtype != GgmlType::F32
+        || !y.is_writable()
+        || weight.shape != [n_in as u64, weight_rows as u64]
+        || x.shape != [x_token_stride as u64, n_tokens as u64]
+        || y.shape != [y_token_stride as u64, n_tokens as u64]
+        || x_group_end > x_token_stride
+        || y_group_end > y_token_stride
+        || weight.offset % 2 != 0
+        || x.offset % 4 != 0
+        || y.offset % 4 != 0
+        || !fits_buffer(weight)
+        || !fits_buffer(x)
+        || !fits_buffer(y)
+        || [
+            n_in,
+            n_out,
+            n_tokens,
+            group_count,
+            x_token_stride,
+            y_token_stride,
+            x_group_stride,
+            y_group_stride,
+        ]
+        .into_iter()
+        .any(|value| u32::try_from(value).is_err())
+    {
+        return Err(bad_shape(format!(
+            "expected Q8_0 [{n_in},{}] and writable F32 [{n_tokens},{x_token_stride}] -> [{n_tokens},{y_token_stride}] with {group_count} in-bounds groups; got weight={:?}/{:?} x={:?}/{:?} y={:?}/{:?}",
+            weight_rows,
+            weight.dtype,
+            weight.shape,
+            x.dtype,
+            x.shape,
+            y.dtype,
+            y.shape
+        )));
+    }
+
+    let pso = ctx.pipeline(match token_tile {
+        4 => "kernel_mat_vec_q8_0_f32_lcpp_t4",
+        8 => "kernel_mat_vec_q8_0_f32_lcpp_t8",
+        _ => unreachable!(),
+    })?;
+    enc.set_pipeline(&pso);
+    #[repr(C)]
+    #[derive(Clone, Copy, bytemuck::Pod, bytemuck::Zeroable)]
+    struct Args {
+        weight_group_stride_bytes: u64,
+        n_in: u32,
+        n_out: u32,
+        n_tokens: u32,
+        x_token_stride: u32,
+        y_token_stride: u32,
+        x_group_stride: u32,
+        y_group_stride: u32,
+        _pad: u32,
+    }
+    enc.set_bytes(
+        0,
+        &Args {
+            weight_group_stride_bytes: weight_group_stride_bytes as u64,
+            n_in: n_in as u32,
+            n_out: n_out as u32,
+            n_tokens: n_tokens as u32,
+            x_token_stride: x_token_stride as u32,
+            y_token_stride: y_token_stride as u32,
+            x_group_stride: x_group_stride as u32,
+            y_group_stride: y_group_stride as u32,
+            _pad: 0,
+        },
+    );
+    enc.set_tensor(1, weight);
+    enc.set_tensor(2, x);
+    enc.set_tensor(3, y);
+    const NR0: usize = 2;
+    const NSG: usize = 4;
+    enc.set_threadgroup_memory(
+        0,
+        token_tile * NR0 * 32 * std::mem::size_of::<f32>(),
+    );
+    enc.dispatch(
+        MTLSize {
+            width: n_out.div_ceil(NR0),
+            height: n_tokens.div_ceil(token_tile),
+            depth: group_count,
+        },
+        MTLSize {
+            width: NSG * 32,
+            height: 1,
+            depth: 1,
+        },
+    );
+    Ok(())
+}
 
