+        fn median(values: &[f64]) -> f64 {
+            let mut values = values.to_vec();
+            values.sort_by(f64::total_cmp);
+            if values.len().is_multiple_of(2) {
+                (values[values.len() / 2 - 1] + values[values.len() / 2]) * 0.5
+            } else {
+                values[values.len() / 2]
+            }
+        }
+
+        fn relative_span(values: &[f64]) -> f64 {
+            let minimum = values.iter().copied().reduce(f64::min).unwrap();
+            let maximum = values.iter().copied().reduce(f64::max).unwrap();
+            drift(minimum, maximum)
+        }
+
+        fn packed_decision_digest(capture: &prefill::PackedPrefillDecisionCapture) -> [u8; 32] {
+            let mut digest = Sha256::new();
+            for record in &capture.layers {
+                digest.update(record.chunk_start.to_le_bytes());
+                digest.update((record.n_tokens as u64).to_le_bytes());
+                digest.update((record.layer as u64).to_le_bytes());
+                digest.update([match record.attention_kind {
+                    AttentionKind::SlidingWindow => 0,
+                    AttentionKind::CompressedSparse => 1,
+                    AttentionKind::HeavilyCompressed => 2,
+                }]);
+                digest.update(
+                    record
+                        .sparse_query_offset
+                        .map_or(u64::MAX, |offset| offset as u64)
+                        .to_le_bytes(),
+                );
+                digest.update([match record.route_source {
+                    prefill::PackedPrefillRouteSourceKind::Hash => 0,
+                    prefill::PackedPrefillRouteSourceKind::Learned => 1,
+                }]);
+                digest.update(bytemuck::cast_slice(&record.expert_ids));
+                for value in &record.weights {
+                    digest.update(value.to_bits().to_le_bytes());
+                }
+                digest.update(bytemuck::cast_slice(&record.bucket_rows));
+                digest.update(bytemuck::cast_slice(&record.bucket_slots));
+                for bucket in &record.buckets {
+                    digest.update((bucket.expert as u64).to_le_bytes());
+                    digest.update((bucket.start as u64).to_le_bytes());
+                    digest.update((bucket.len as u64).to_le_bytes());
+                }
+                for margin in &record.learned_cutoff_margins {
+                    digest.update(margin.to_bits().to_le_bytes());
+                }
+            }
+            digest.finalize().into()
+        }
+
+        struct PackedDecisionAudit {
+            structure_exact: bool,
+            sparse_selector_invocations: usize,
+            maximum_weight_delta: f32,
+            minimum_control_cutoff_margin: f32,
+            minimum_candidate_cutoff_margin: f32,
+            maximum_cutoff_margin_delta: f32,
+        }
+
+        fn audit_packed_decisions(
+            control: &prefill::PackedPrefillDecisionCapture,
+            candidate: &prefill::PackedPrefillDecisionCapture,
+        ) -> PackedDecisionAudit {
+            let mut structure_exact = control.layers.len() == candidate.layers.len();
+            let mut sparse_selector_invocations = 0usize;
+            let mut maximum_weight_delta = 0.0f32;
+            let mut minimum_control_cutoff_margin = f32::INFINITY;
+            let mut minimum_candidate_cutoff_margin = f32::INFINITY;
+            let mut maximum_cutoff_margin_delta = 0.0f32;
+            for (control, candidate) in control.layers.iter().zip(&candidate.layers) {
+                sparse_selector_invocations += usize::from(control.sparse_query_offset.is_some());
+                sparse_selector_invocations += usize::from(candidate.sparse_query_offset.is_some());
+                structure_exact &= control.chunk_start == candidate.chunk_start
+                    && control.n_tokens == candidate.n_tokens
+                    && control.layer == candidate.layer
+                    && control.attention_kind == candidate.attention_kind
+                    && control.sparse_query_offset == candidate.sparse_query_offset
+                    && control.route_source == candidate.route_source
+                    && control.expert_ids == candidate.expert_ids
+                    && control.bucket_rows == candidate.bucket_rows
+                    && control.bucket_slots == candidate.bucket_slots
+                    && control.buckets == candidate.buckets
+                    && control.weights.len() == candidate.weights.len()
+                    && control.learned_cutoff_margins.len()
+                        == candidate.learned_cutoff_margins.len();
+                for (&control, &candidate) in control.weights.iter().zip(&candidate.weights) {
+                    maximum_weight_delta = maximum_weight_delta.max((candidate - control).abs());
+                }
+                for (&control, &candidate) in control
+                    .learned_cutoff_margins
+                    .iter()
+                    .zip(&candidate.learned_cutoff_margins)
+                {
+                    minimum_control_cutoff_margin = minimum_control_cutoff_margin.min(control);
+                    minimum_candidate_cutoff_margin =
+                        minimum_candidate_cutoff_margin.min(candidate);
+                    maximum_cutoff_margin_delta =
+                        maximum_cutoff_margin_delta.max((candidate - control).abs());
+                }
+            }
+            PackedDecisionAudit {
+                structure_exact,
+                sparse_selector_invocations,
+                maximum_weight_delta,
+                minimum_control_cutoff_margin,
+                minimum_candidate_cutoff_margin,
+                maximum_cutoff_margin_delta,
+            }
+        }
+
+        fn continuation_route_audit(
