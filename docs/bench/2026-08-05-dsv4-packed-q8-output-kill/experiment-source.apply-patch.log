+            } else {
+                0
+            };
+            assert_eq!(control_before.matrix_invocations, 0);
+            assert_eq!(control_after.matrix_invocations, 0);
+            assert_eq!(candidate_first.matrix_invocations, expected_invocations);
+            assert_eq!(candidate_second.matrix_invocations, expected_invocations);
+
+            if n_tokens < 32 {
+                assert_exact("matrix-output threshold fallback", &candidate_first, &control_before);
+            } else {
+                assert_eq!(candidate_first.prefix_digest, control_before.prefix_digest);
+                assert_eq!(
+                    candidate_first.compatibility_digest,
+                    control_before.compatibility_digest
+                );
+                assert_eq!(candidate_first.committed_tokens, control_before.committed_tokens);
+                assert_ne!(bits(&candidate_first.logits), bits(&control_before.logits));
+            }
+
+            let logits_diff = differential(&candidate_first.logits, &control_before.logits);
+            let hidden_diff = differential(&candidate_first.hidden, &control_before.hidden);
+            let continuation_diff = differential(
+                &candidate_first.continuation_logits,
+                &control_before.continuation_logits,
+            );
+            let packed_argmax = argmax(&control_before.logits);
+            let candidate_packed_argmax = argmax(&candidate_first.logits);
+            let continuation_argmax = argmax(&control_before.continuation_logits);
+            let candidate_continuation_argmax = argmax(&candidate_first.continuation_logits);
+            let control_gpu_drift = drift(
+                control_before.pre_expert_gpu_ms,
+                control_after.pre_expert_gpu_ms,
+            );
+            let candidate_gpu_drift = drift(
+                candidate_first.pre_expert_gpu_ms,
+                candidate_second.pre_expert_gpu_ms,
+            );
+            let control_wall_drift = drift(control_before.wall_ms, control_after.wall_ms);
+            let candidate_wall_drift = drift(candidate_first.wall_ms, candidate_second.wall_ms);
+            let faster_control_gpu = control_before
+                .pre_expert_gpu_ms
+                .min(control_after.pre_expert_gpu_ms);
+            let candidate_gpu =
+                (candidate_first.pre_expert_gpu_ms + candidate_second.pre_expert_gpu_ms) * 0.5;
+            let faster_control_wall = control_before.wall_ms.min(control_after.wall_ms);
+            let candidate_wall = (candidate_first.wall_ms + candidate_second.wall_ms) * 0.5;
+            let gpu_saving = 1.0 - candidate_gpu / faster_control_gpu;
+            let wall_saving = 1.0 - candidate_wall / faster_control_wall;
+
+            eprintln!(
+                "deepseek_v4 packed_matrix_q8_output n={n_tokens} control_gpu_ms={:?} candidate_gpu_ms={:?} control_wall_ms={:?} candidate_wall_ms={:?} control_gpu_drift={control_gpu_drift:.6} candidate_gpu_drift={candidate_gpu_drift:.6} control_wall_drift={control_wall_drift:.6} candidate_wall_drift={candidate_wall_drift:.6} gpu_saving={gpu_saving:.6} wall_saving={wall_saving:.6} matrix_invocations={expected_invocations} packed_argmax={packed_argmax} candidate_packed_argmax={candidate_packed_argmax} continuation_argmax={continuation_argmax} candidate_continuation_argmax={candidate_continuation_argmax} logits_diff={logits_diff:?} hidden_diff={hidden_diff:?} continuation_diff={continuation_diff:?} control_logits_sha256={} candidate_logits_sha256={} control_causal={} candidate_causal={} control_continuation_causal={} candidate_continuation_causal={}",
+                [
+                    control_before.pre_expert_gpu_ms,
+                    control_after.pre_expert_gpu_ms
+                ],
+                [
+                    candidate_first.pre_expert_gpu_ms,
+                    candidate_second.pre_expert_gpu_ms
+                ],
+                [control_before.wall_ms, control_after.wall_ms],
+                [candidate_first.wall_ms, candidate_second.wall_ms],
+                digest_hex(Sha256::digest(bytemuck::cast_slice(&control_before.logits))),
+                digest_hex(Sha256::digest(bytemuck::cast_slice(&candidate_first.logits))),
+                digest_hex(control_before.causal_digest),
+                digest_hex(candidate_first.causal_digest),
+                digest_hex(control_before.continuation_causal_digest),
+                digest_hex(candidate_first.continuation_causal_digest),
+            );
+
+            assert_eq!(candidate_packed_argmax, packed_argmax);
+            assert_eq!(candidate_continuation_argmax, continuation_argmax);
+            for (label, diff) in [
+                ("logits", logits_diff),
+                ("hidden", hidden_diff),
+                ("continuation", continuation_diff),
+            ] {
+                assert!(
+                    diff.0 >= 0.999 && diff.1 <= 0.05,
+                    "N={n_tokens} {label} matrix-output differential exceeded probe envelope: {diff:?}"
+                );
+            }
+            if n_tokens == 128 {
+                assert!(control_gpu_drift <= 0.05);
+                assert!(candidate_gpu_drift <= 0.05);
+                assert!(control_wall_drift <= 0.05);
+                assert!(candidate_wall_drift <= 0.05);
+                assert!(gpu_saving >= 0.15);
+                assert!(wall_saving >= 0.05);
+            }
+        }
+        drop(residency);
+    }
 
