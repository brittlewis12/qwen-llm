+    #[test]
+    fn q8_token_tiled_gemv_preserves_grouped_singleton_bits_and_guards() {
+        let Ok(ctx) = MetalContext::new() else {
+            return;
+        };
+        const GUARD: usize = 64;
+        const N_IN: usize = 64;
+        const N_OUT: usize = 7;
+        const GROUPS: usize = 3;
+        const X_STRIDE: usize = GROUPS * N_IN + 32;
+        const Y_STRIDE: usize = GROUPS * N_OUT + 5;
+
+        let mut weight_payload = Vec::with_capacity(N_OUT * GROUPS * (N_IN / 32) * 34);
+        for row in 0..N_OUT * GROUPS {
+            for block in 0..N_IN / 32 {
+                let scale = half::f16::from_f32(0.0065 + row as f32 * 0.000_17);
+                weight_payload.extend_from_slice(&scale.to_bits().to_le_bytes());
+                for index in 0..32 {
+                    let quant = ((row * 23 + block * 17 + index * 11) % 113) as i8 - 56;
+                    weight_payload.push(quant as u8);
+                }
+            }
+        }
+        let mut guarded_weight = vec![0xa5; GUARD];
+        guarded_weight.extend_from_slice(&weight_payload);
+        guarded_weight.extend_from_slice(&[0x5a; GUARD]);
+        let weight = MetalTensor {
+            buffer: ctx.buffer_from(&guarded_weight).unwrap(),
+            offset: GUARD as u64,
+            shape: vec![N_IN as u64, (N_OUT * GROUPS) as u64],
+            dtype: GgmlType::Q8_0,
+            provenance: MetalTensorProvenance::OwnedWritable,
+        };
+
+        for n_tokens in [1, 3, 4, 7, 8, 9] {
+            let input_values = (0..n_tokens * X_STRIDE)
+                .map(|index| ((index * 29 + index / 7 + 3) % 127) as f32 * 0.009 - 0.53)
+                .collect::<Vec<_>>();
+            let mut guarded_input = vec![0x3c; GUARD];
+            guarded_input.extend_from_slice(bytemuck::cast_slice(&input_values));
+            guarded_input.extend_from_slice(&[0xc3; GUARD]);
+            let input = MetalTensor {
+                buffer: ctx.buffer_from(&guarded_input).unwrap(),
+                offset: GUARD as u64,
+                shape: vec![X_STRIDE as u64, n_tokens as u64],
+                dtype: GgmlType::F32,
+                provenance: MetalTensorProvenance::OwnedWritable,
+            };
+
+            for token_tile in [4, 8] {
+                let reference = grouped_guarded_f32(
+                    &ctx,
+                    vec![Y_STRIDE as u64, n_tokens as u64],
+                    91.0,
+                );
+                let candidate = grouped_guarded_f32(
+                    &ctx,
+                    vec![Y_STRIDE as u64, n_tokens as u64],
+                    91.0,
+                );
+                let repeat = grouped_guarded_f32(
+                    &ctx,
+                    vec![Y_STRIDE as u64, n_tokens as u64],
+                    91.0,
+                );
+                let command = ctx.queue.commandBuffer().unwrap();
+                let encoder = KernelEncoder::begin(&command);
+                let config = crate::metal::MatVecQ8TokenTiledConfig {
+                    n_in: N_IN,
+                    n_out: N_OUT,
+                    n_tokens,
+                    token_tile,
+                    group_count: GROUPS,
+                    x_token_stride: X_STRIDE,
+                    y_token_stride: Y_STRIDE,
+                    x_group_stride: N_IN,
+                    y_group_stride: N_OUT,
+                };
+                crate::metal::encode_mat_vec_q8_0_token_tiled_f32(
+                    &ctx, &encoder, &weight, &input, &candidate, config,
+                )
+                .unwrap();
+                crate::metal::encode_mat_vec_q8_0_token_tiled_f32(
+                    &ctx, &encoder, &weight, &input, &repeat, config,
+                )
+                .unwrap();
+                for token in 0..n_tokens {
+                    for group in 0..GROUPS {
+                        let weight = group_weight_view(&weight, N_IN, N_OUT, group).unwrap();
+                        let input = input.view_subrange(
+                            (token * X_STRIDE + group * N_IN) as u64,
+                            vec![N_IN as u64],
+                        );
+                        let output = reference.view_subrange(
+                            (token * Y_STRIDE + group * N_OUT) as u64,
+                            vec![N_OUT as u64],
+                        );
+                        crate::metal::encode_mat_vec_q8_0_f32(
+                            &ctx, &encoder, &weight, &input, &output, N_IN, N_OUT,
+                        )
+                        .unwrap();
+                    }
+                }
+                encoder.end();
+                command.commit();
+                command.waitUntilCompleted();
+                assert!(command.error().is_none());
+
+                let reference = host_read_f32(&reference, "tiled Q8 reference").unwrap();
+                let candidate = host_read_f32(&candidate, "tiled Q8 candidate").unwrap();
+                let repeat = host_read_f32(&repeat, "tiled Q8 repeat").unwrap();
+                assert_eq!(
+                    candidate
+                        .iter()
+                        .map(|value| value.to_bits())
+                        .collect::<Vec<_>>(),
+                    reference
+                        .iter()
+                        .map(|value| value.to_bits())
+                        .collect::<Vec<_>>(),
+                    "N={n_tokens} T={token_tile} candidate"
+                );
+                assert_eq!(
+                    repeat
+                        .iter()
+                        .map(|value| value.to_bits())
+                        .collect::<Vec<_>>(),
+                    reference
+                        .iter()
+                        .map(|value| value.to_bits())
+                        .collect::<Vec<_>>(),
+                    "N={n_tokens} T={token_tile} repeat"
+                );
+                assert_grouped_guards("tiled Q8 reference", &reference);
+                assert_grouped_guards("tiled Q8 candidate", &candidate);
+                assert_grouped_guards("tiled Q8 repeat", &repeat);
+            }
+        }
+
+        let base = weight.buffer.contents().as_ptr().cast::<u8>();
+        let prefix = unsafe { std::slice::from_raw_parts(base, GUARD) };
+        let suffix = unsafe {
+            std::slice::from_raw_parts(base.add(GUARD + weight_payload.len()), GUARD)
+        };
+        assert!(prefix.iter().all(|&byte| byte == 0xa5));
+        assert!(suffix.iter().all(|&byte| byte == 0x5a));
+    }
 }
