+// Exact diagnostics candidate: each simdgroup reuses one query load across two
+// independent rows while preserving dimension and head reduction order.
+[[max_total_threads_per_threadgroup(256)]]
+kernel void kernel_deepseek_v4_lightning_indexer_scores_f16_cooperative_r2(
+        constant ds4_indexer_score_args & args [[buffer(0)]],
+        device const float * queries [[buffer(1)]],
+        device const float * head_weights [[buffer(2)]],
+        device const half * keys [[buffer(3)]],
+        device const int * visible_counts [[buffer(4)]],
+        device float * scores [[buffer(5)]],
+        threadgroup half * staged_keys [[threadgroup(0)]],
+        threadgroup float * head_dots [[threadgroup(1)]],
+        uint2 group [[threadgroup_position_in_grid]],
+        ushort lane [[thread_index_in_simdgroup]],
+        ushort simdgroup [[simdgroup_index_in_threadgroup]]) {
+    const uint rows_per_simdgroup = 2u;
+    const uint rows_per_group = 8u * rows_per_simdgroup;
+    const uint row0 = group.x * rows_per_group
+            + uint(simdgroup) * rows_per_simdgroup;
+    const uint row1 = row0 + 1u;
+    const uint query = group.y;
+    if (query >= args.query_count || row0 >= args.row_capacity) return;
+
+    const int visible = visible_counts[query];
+    const bool exists1 = row1 < args.row_capacity;
+    const bool active0 = visible >= 0 && row0 < uint(visible);
+    const bool active1 = exists1 && visible >= 0 && row1 < uint(visible);
+    const uint score_base = query * args.row_capacity;
+    if (lane == 0) {
+        if (!active0) scores[score_base + row0] = -INFINITY;
+        if (exists1 && !active1) scores[score_base + row1] = -INFINITY;
+    }
+    if (!active0 && !active1) return;
+
+    threadgroup half * key_rows = staged_keys
+            + uint(simdgroup) * rows_per_simdgroup * 128u;
+    for (uint dimension = uint(lane); dimension < 128u; dimension += 32u) {
+        if (active0) key_rows[dimension] = keys[row0 * 128u + dimension];
+        if (active1) key_rows[128u + dimension] = keys[row1 * 128u + dimension];
+    }
+    simdgroup_barrier(mem_flags::mem_threadgroup);
+
+    const uint query_base = query * 64u * 128u;
+    threadgroup float * dots = head_dots
+            + uint(simdgroup) * rows_per_simdgroup * 64u;
+    for (uint head_group = 0u; head_group < 2u; ++head_group) {
+        const uint head = uint(lane) + head_group * 32u;
+        const uint head_base = query_base + head * 128u;
+        float dot0 = 0.0f;
+        float dot1 = 0.0f;
+        for (uint dimension = 0u; dimension < 128u; ++dimension) {
+            const float query_value = queries[head_base + dimension];
+            if (active0) dot0 += query_value * float(key_rows[dimension]);
+            if (active1) dot1 += query_value * float(key_rows[128u + dimension]);
+        }
+        if (active0) dots[head] = dot0;
+        if (active1) dots[64u + head] = dot1;
+    }
+    simdgroup_barrier(mem_flags::mem_threadgroup);
+
+    if (lane == 0) {
+        const uint weight_base = query * 64u;
+        if (active0) {
+            float score = 0.0f;
+            for (uint head = 0u; head < 64u; ++head) {
+                score += max(dots[head], 0.0f) * head_weights[weight_base + head];
+            }
+            scores[score_base + row0] = score;
+        }
+        if (active1) {
+            float score = 0.0f;
+            for (uint head = 0u; head < 64u; ++head) {
+                score += max(dots[64u + head], 0.0f) * head_weights[weight_base + head];
+            }
+            scores[score_base + row1] = score;
+        }
+    }
+}
