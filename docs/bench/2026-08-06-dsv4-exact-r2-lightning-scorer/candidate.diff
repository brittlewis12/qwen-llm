+        unsafe {
+            let bytes = std::slice::from_raw_parts(
+                tensor.buffer.contents().as_ptr().cast::<u8>(),
+                tensor.buffer.length(),
+            );
+            bytes[..tensor.offset as usize]
+                .iter()
+                .all(|&byte| byte == 0xA5)
+                && bytes[payload_end..].iter().all(|&byte| byte == 0x5A)
+        }
+    }
