+    fn offset_f32_guards_intact(tensor: &MetalTensor) -> bool {
+        if tensor.dtype != GgmlType::F32 || tensor.offset != 16 {
+            return false;
+        }
+        let payload_end = tensor.offset as usize + tensor.n_bytes() as usize;
+        if tensor.buffer.length() != payload_end + 20 {
