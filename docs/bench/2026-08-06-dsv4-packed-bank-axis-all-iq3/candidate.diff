+    #[cfg(feature = "dsv4-diagnostics")]
+    #[test]
+    #[ignore = "frozen bank-axis all-IQ3 profiler; run release once with --nocapture"]
+    fn profile_packed_grouped_bank_axis_all_iq3_production_routes() {
+        #[derive(Debug)]
+        enum GateVerdict {
+            Authorize,
+            Hold(String),
+            Kill(String),
+        }
+
+        let outcome = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+            let Ok(ctx) = MetalContext::new() else {
+                return GateVerdict::Hold("metal_context_unavailable".into());
+            };
+            assert_eq!(
+                ctx.device.name().to_string(),
+                PACKED_GROUPED_EXPERT_QUALIFIED_DEVICE
+            );
+            assert!(
+                packed_grouped_iq3_bank_candidate_supported(&ctx),
+                "bank-axis all-IQ3 pipeline is not qualified"
+            );
+
+            const H: usize = 4_096;
+            const F: usize = 2_048;
+            const E: usize = MOE_EXPERT_COUNT;
+            const K: usize = MOE_TOP_K;
+            const N: usize = DEEPSEEK_V4_PREFILL_MAX_TOKENS;
+            const ROUTES: usize = N * K;
+            const CLAMP: f32 = 7.0;
+            const LAYERS: usize = 16;
+            const SAMPLES_PER_ARM: usize = 12;
+            const ABSOLUTE_GATE_MS: f64 = 158.3;
+            const RELATIVE_GATE: f64 = 0.15;
+
+            #[derive(Clone, Copy, Debug, Eq, PartialEq)]
+            enum Arm {
+                Control,
+                Candidate,
+            }
+
+            struct LayerRoute {
+                layer: usize,
+                rows: MetalTensor,
+                slots: MetalTensor,
+                schedule: Vec<ExpertBucket>,
+            }
+
+            fn timing_bank(ctx: &MetalContext, n_in: usize, n_out: usize, fill: u8) -> MetalTensor {
+                let (block_elements, block_bytes) = ggml_type_layout(GgmlType::IQ3_XXS).unwrap();
+                let elements = n_in * n_out * E;
+                assert!(elements.is_multiple_of(block_elements as usize));
+                let bytes = elements / block_elements as usize * block_bytes as usize;
+                let buffer = ctx.buffer_uninit(bytes).unwrap();
+                unsafe {
+                    std::ptr::write_bytes(buffer.contents().as_ptr().cast::<u8>(), fill, bytes);
+                }
+                MetalTensor {
+                    buffer,
+                    offset: 0,
+                    shape: vec![n_in as u64, n_out as u64, E as u64],
+                    dtype: GgmlType::IQ3_XXS,
+                    provenance: MetalTensorProvenance::OwnedWritable,
+                }
+            }
+
+            fn upper_median(values: &[f64]) -> f64 {
+                assert_eq!(values.len(), SAMPLES_PER_ARM);
+                let mut sorted = values.to_vec();
+                sorted.sort_by(f64::total_cmp);
+                sorted[SAMPLES_PER_ARM / 2]
+            }
+
+            fn range(values: &[f64]) -> f64 {
+                let min = values.iter().copied().min_by(f64::total_cmp).unwrap();
+                let max = values.iter().copied().max_by(f64::total_cmp).unwrap();
+                max - min
+            }
+
+            fn maximum(values: &[f64]) -> f64 {
+                values.iter().copied().max_by(f64::total_cmp).unwrap()
+            }
+
+            fn payload_sha256(tensor: &MetalTensor) -> String {
+                let payload = unsafe {
+                    std::slice::from_raw_parts(
+                        tensor
+                            .buffer
+                            .contents()
+                            .as_ptr()
+                            .cast::<u8>()
+                            .add(tensor.offset as usize),
+                        tensor.n_bytes() as usize,
+                    )
+                };
+                format!("{:x}", Sha256::digest(payload))
+            }
+
+            fn update_tensor_digest(hasher: &mut Sha256, tensor: &MetalTensor) {
