+#[cfg(test)]
+#[allow(clippy::too_many_arguments)]
+fn encode_packed_grouped_mapped_bank_iq3_xxs_f32(
+    ctx: &MetalContext,
+    enc: &KernelEncoder,
+    gate_bank: &MetalTensor,
+    up_bank: &MetalTensor,
+    input: &MetalTensor,
+    source_rows: &MetalTensor,
+    destination_slots: &MetalTensor,
+    schedule: &[ExpertBucket],
+    gate_up_arena: &MetalTensor,
+    n_in: usize,
+    n_out: usize,
+    expert_count: usize,
+    top_k: usize,
+    n_tokens: usize,
+    source_count: usize,
+    destination_count: usize,
+) -> Result<(), DeepSeekV4MetalError> {
+    require_serial(enc, "packed grouped mapped bank-axis IQ3_XXS projection")?;
+    if !crate::metal::matmat_iq3_xxs_mm_is_enabled() {
+        return invalid("packed grouped mapped bank-axis IQ3_XXS requires the SIMD-matrix policy");
+    }
+    if !n_in.is_multiple_of(256)
+        || !n_out.is_multiple_of(64)
+        || n_in != 2 * n_out
+        || expert_count != MOE_EXPERT_COUNT
+        || top_k != MOE_TOP_K
+        || source_count == 0
+        || destination_count == 0
+        || gate_bank.dtype != GgmlType::IQ3_XXS
+        || up_bank.dtype != GgmlType::IQ3_XXS
+    {
+        return invalid("packed grouped mapped bank-axis IQ3_XXS has invalid geometry or storage");
+    }
+    validate_expert_bank(
+        gate_bank,
+        n_in,
+        n_out,
+        expert_count,
+        "packed grouped mapped bank-axis IQ3_XXS gate bank",
+    )?;
+    validate_expert_bank(
+        up_bank,
+        n_in,
+        n_out,
+        expert_count,
+        "packed grouped mapped bank-axis IQ3_XXS up bank",
+    )?;
+    validate_f32(
+        input,
+        &[n_in as u64, source_count as u64],
+        false,
+        "packed grouped mapped bank-axis IQ3_XXS input",
+    )?;
+    let map_count = checked_mul(n_tokens, top_k, "packed grouped mapped bank-axis row count")?;
+    validate_i32(
+        source_rows,
+        &[map_count as u64],
+        false,
+        "packed grouped mapped bank-axis IQ3_XXS source rows",
+    )?;
+    validate_i32(
+        destination_slots,
+        &[map_count as u64],
+        false,
+        "packed grouped mapped bank-axis IQ3_XXS destination slots",
+    )?;
+    let (gate, up) =
+        packed_grouped_iq3_gate_up_views(gate_up_arena, n_in, n_out, destination_count)?;
+    let tiles = packed_grouped_expert_tiles(n_tokens, schedule)?;
+    let tile_count = tiles.len();
+    #[repr(C)]
+    #[derive(Clone, Copy, bytemuck::Pod, bytemuck::Zeroable)]
+    struct Args {
+        m: u32,
+        k: u32,
+        nb01: u32,
+        stride_b: u32,
+        n_expert: u32,
+        map_count: u32,
+        source_count: u32,
+        destination_count: u32,
+    }
+    let row_bytes = checked_mul(
+        n_in / 256,
+        98,
+        "packed grouped mapped bank-axis IQ3_XXS row",
+    )?;
+    let pso = ctx.pipeline("kernel_deepseek_v4_packed_grouped_mapped_bank_iq3_xxs_f32_mm")?;
+    if pso.threadExecutionWidth() != 32 || pso.maxTotalThreadsPerThreadgroup() < 128 {
+        return invalid("packed grouped mapped bank-axis IQ3_XXS requires four SIMD groups");
+    }
+    enc.set_pipeline(&pso);
+    enc.set_bytes(
+        0,
+        &Args {
+            m: u32::try_from(n_out).map_err(|_| {
+                DeepSeekV4MetalError::Invalid(
+                    "packed grouped mapped bank-axis output exceeds u32".into(),
+                )
+            })?,
+            k: u32::try_from(n_in).map_err(|_| {
+                DeepSeekV4MetalError::Invalid(
+                    "packed grouped mapped bank-axis input exceeds u32".into(),
+                )
+            })?,
+            nb01: u32::try_from(row_bytes).map_err(|_| {
+                DeepSeekV4MetalError::Invalid(
+                    "packed grouped mapped bank-axis row bytes exceed u32".into(),
+                )
+            })?,
+            stride_b: u32::try_from(n_in).map_err(|_| {
+                DeepSeekV4MetalError::Invalid(
+                    "packed grouped mapped bank-axis stride exceeds u32".into(),
+                )
+            })?,
+            n_expert: u32::try_from(expert_count).map_err(|_| {
+                DeepSeekV4MetalError::Invalid(
+                    "packed grouped mapped bank-axis experts exceed u32".into(),
+                )
+            })?,
+            map_count: u32::try_from(map_count).map_err(|_| {
+                DeepSeekV4MetalError::Invalid(
+                    "packed grouped mapped bank-axis count exceeds u32".into(),
+                )
+            })?,
+            source_count: u32::try_from(source_count).map_err(|_| {
+                DeepSeekV4MetalError::Invalid(
+                    "packed grouped mapped bank-axis source count exceeds u32".into(),
+                )
+            })?,
+            destination_count: u32::try_from(destination_count).map_err(|_| {
+                DeepSeekV4MetalError::Invalid(
+                    "packed grouped mapped bank-axis destination count exceeds u32".into(),
+                )
+            })?,
+        },
+    );
+    enc.set_tensor(1, gate_bank);
+    enc.set_tensor(2, up_bank);
+    enc.set_tensor(3, input);
+    enc.set_tensor(4, source_rows);
+    enc.set_tensor(5, destination_slots);
+    enc.set_bytes_slice(6, &tiles);
+    enc.set_tensor(7, &gate);
+    enc.set_tensor(8, &up);
+    enc.set_threadgroup_memory(0, 8_192);
+    enc.dispatch(
+        MTLSize {
+            width: tile_count,
+            height: n_out / 64,
+            depth: 2,
+        },
+        MTLSize {
+            width: 128,
+            height: 1,
+            depth: 1,
+        },
+    );
+    Ok(())
+}
