+        if let Some(previous) = self.layers.last() {
+            let same_chunk = previous.chunk_start == record.chunk_start;
+            let ordered = if same_chunk {
+                record.n_tokens == previous.n_tokens && record.layer == previous.layer + 1
+            } else {
+                let previous_tokens = u32::try_from(previous.n_tokens).map_err(|_| {
+                    DeepSeekV4MetalError::Invalid("packed decision token count exceeds u32".into())
+                })?;
+                record.layer == 0
+                    && record.chunk_start
+                        == previous
+                            .chunk_start
+                            .checked_add(previous_tokens)
+                            .ok_or_else(|| {
+                                DeepSeekV4MetalError::Invalid(
+                                    "packed decision chunk position overflow".into(),
+                                )
+                            })?
+            };
+            if !ordered {
+                return invalid("packed decision records are not in chunk/layer order");
+            }
+        } else if record.layer != 0 {
+            return invalid("packed decision capture must begin at layer zero");
+        }
+        self.layers.push(record);
+        Ok(())
+    }
