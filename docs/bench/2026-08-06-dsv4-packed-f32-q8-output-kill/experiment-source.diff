+        fn argmax(values: &[f32]) -> usize {
+            values
+                .iter()
+                .enumerate()
+                .max_by(|(left_index, left), (right_index, right)| {
+                    left.total_cmp(right)
+                        .then_with(|| right_index.cmp(left_index))
+                })
+                .expect("nonempty logits")
+                .0
+        }
