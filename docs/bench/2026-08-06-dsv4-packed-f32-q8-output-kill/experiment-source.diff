+            weights,
+            bucket_rows,
+            bucket_slots,
+            buckets: schedule
+                .iter()
+                .map(|bucket| PackedPrefillExpertBucket {
+                    expert: bucket.expert,
+                    start: bucket.start,
+                    len: bucket.len,
+                })
+                .collect(),
+            learned_cutoff_margins,
+        })
+    }
