+                    checked_mul(n_tokens, MOE_EXPERT_COUNT, "packed decision route logits")?;
+                if logits.len() < expected_logits || bias.len() != MOE_EXPERT_COUNT {
+                    return invalid("packed decision route inputs have invalid lengths");
+                }
+                let mut margins = Vec::with_capacity(n_tokens);
+                for token in 0..n_tokens {
