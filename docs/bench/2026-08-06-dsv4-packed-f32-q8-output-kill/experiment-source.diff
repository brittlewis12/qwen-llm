+        fn audit_packed_decisions(
+            control: &prefill::PackedPrefillDecisionCapture,
+            candidate: &prefill::PackedPrefillDecisionCapture,
+        ) -> PackedDecisionAudit {
+            let mut structure_exact = control.layers.len() == candidate.layers.len();
+            let mut sparse_selector_invocations = 0usize;
+            let mut maximum_weight_delta = 0.0f32;
+            let mut minimum_control_cutoff_margin = f32::INFINITY;
+            let mut minimum_candidate_cutoff_margin = f32::INFINITY;
+            let mut maximum_cutoff_margin_delta = 0.0f32;
+            for (control, candidate) in control.layers.iter().zip(&candidate.layers) {
+                sparse_selector_invocations += usize::from(control.sparse_query_offset.is_some());
+                sparse_selector_invocations += usize::from(candidate.sparse_query_offset.is_some());
+                structure_exact &= control.chunk_start == candidate.chunk_start
+                    && control.n_tokens == candidate.n_tokens
+                    && control.layer == candidate.layer
+                    && control.attention_kind == candidate.attention_kind
+                    && control.sparse_query_offset == candidate.sparse_query_offset
+                    && control.route_source == candidate.route_source
+                    && control.expert_ids == candidate.expert_ids
+                    && control.bucket_rows == candidate.bucket_rows
+                    && control.bucket_slots == candidate.bucket_slots
+                    && control.buckets == candidate.buckets
+                    && control.weights.len() == candidate.weights.len()
+                    && control.learned_cutoff_margins.len()
+                        == candidate.learned_cutoff_margins.len();
+                for (&control, &candidate) in control.weights.iter().zip(&candidate.weights) {
+                    maximum_weight_delta = maximum_weight_delta.max((candidate - control).abs());
+                }
+                for (&control, &candidate) in control
+                    .learned_cutoff_margins
+                    .iter()
+                    .zip(&candidate.learned_cutoff_margins)
+                {
+                    minimum_control_cutoff_margin = minimum_control_cutoff_margin.min(control);
+                    minimum_candidate_cutoff_margin =
+                        minimum_candidate_cutoff_margin.min(candidate);
+                    maximum_cutoff_margin_delta =
+                        maximum_cutoff_margin_delta.max((candidate - control).abs());
+                }
+            }
+            PackedDecisionAudit {
+                structure_exact,
+                sparse_selector_invocations,
+                maximum_weight_delta,
+                minimum_control_cutoff_margin,
+                minimum_candidate_cutoff_margin,
+                maximum_cutoff_margin_delta,
+            }
+        }
