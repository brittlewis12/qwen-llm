+        fn source_contract_sha256(source: &str, start_marker: &str, end_marker: &str) -> String {
+            let start = source
+                .find(start_marker)
+                .unwrap_or_else(|| panic!("missing source-contract start marker {start_marker}"));
+            let tail = &source[start..];
+            let end = tail
+                .find(end_marker)
+                .unwrap_or_else(|| panic!("missing source-contract end marker {end_marker}"));
+            let mut digest = Sha256::new();
+            digest.update(&tail.as_bytes()[..end]);
+            hex(digest.finalize())
+        }
+
+        fn mix64(mut value: u64) -> u64 {
+            value = value.wrapping_add(0x9e37_79b9_7f4a_7c15);
+            value = (value ^ (value >> 30)).wrapping_mul(0xbf58_476d_1ce4_e5b9);
+            value = (value ^ (value >> 27)).wrapping_mul(0x94d0_49bb_1331_11eb);
+            value ^ (value >> 31)
+        }
+
+        fn expert_template() -> (Vec<u8>, usize, usize) {
+            let (block_elements, block_bytes) = ggml_type_layout(GgmlType::IQ2_XS).unwrap();
+            let block_elements = block_elements as usize;
+            let block_bytes = block_bytes as usize;
+            let elements = H * F;
+            assert!(elements.is_multiple_of(block_elements));
+            let blocks = elements / block_elements;
+            let mut payload = vec![0u8; blocks * block_bytes];
+            for block in 0..blocks {
+                let start = block * block_bytes;
+                payload[start..start + 2].copy_from_slice(
+                    &half::f16::from_f32(0.00390625 * (1 + block % 7) as f32)
+                        .to_bits()
+                        .to_le_bytes(),
+                );
+                for byte in 2..block_bytes {
+                    payload[start + byte] =
+                        (block.wrapping_mul(31) + byte.wrapping_mul(13) + 5) as u8;
+                }
+            }
+            (payload, blocks, block_bytes)
+        }
