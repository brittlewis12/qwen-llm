+        let stable = disjoint_stable && warm_stable;
+        let pass = disjoint_pass && warm_pass;
+        let verdict = if !stable {
+            GroupedIq2BroadcastGateVerdict::Hold
+        } else if pass {
+            GroupedIq2BroadcastGateVerdict::Pass
+        } else {
+            GroupedIq2BroadcastGateVerdict::Kill
