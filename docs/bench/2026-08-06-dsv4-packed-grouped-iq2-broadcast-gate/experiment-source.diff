+
+        fn drift(values: &[f64]) -> f64 {
+            let minimum = values.iter().copied().reduce(f64::min).unwrap();
+            let maximum = values.iter().copied().reduce(f64::max).unwrap();
+            assert!(minimum.is_finite() && minimum > 0.0 && maximum.is_finite());
+            (maximum - minimum) / maximum
+        }
+
+        fn value_range(values: &[f64]) -> f64 {
+            values.iter().copied().reduce(f64::max).unwrap()
+                - values.iter().copied().reduce(f64::min).unwrap()
+        }
+
+        fn regime_transcript(
+            regime: Regime,
+            baseline: &[Sample],
+            candidate: &[Sample],
+        ) -> (bool, bool, String) {
+            let baseline_gpu = baseline
+                .iter()
+                .map(|sample| sample.gpu_ms)
+                .collect::<Vec<_>>();
+            let candidate_gpu = candidate
+                .iter()
+                .map(|sample| sample.gpu_ms)
+                .collect::<Vec<_>>();
+            let baseline_wall = baseline
+                .iter()
+                .map(|sample| sample.wall_ms)
+                .collect::<Vec<_>>();
