+                digest.update((layer.layer as u32).to_le_bytes());
+                let output = match arm {
+                    Arm::Baseline => &layer.baseline,
+                    Arm::Candidate => &layer.candidate,
+                };
+                digest.update(bytemuck::cast_slice(logical_values(output)));
+            }
+            hex(digest.finalize())
+        }
+
+        fn assert_output_contract(layers: &[ProfileLayer], arm: Arm) {
+            for layer in layers {
+                let output = match arm {
+                    Arm::Baseline => &layer.baseline,
+                    Arm::Candidate => &layer.candidate,
+                };
+                let values = logical_values(output);
+                assert!(values.iter().all(|value| value.is_finite()));
+                assert!(
+                    values
+                        .iter()
+                        .all(|value| value.to_bits() != OUTPUT_POISON.to_bits()),
+                    "layer {} {arm:?} did not overwrite every output",
+                    layer.layer
+                );
+                assert_grouped_guards("broadcast profile input", &layer.input);
+                assert_grouped_guards("broadcast profile baseline", &layer.baseline);
+                assert_grouped_guards("broadcast profile candidate", &layer.candidate);
+                assert_eq!(
+                    host_read_i32(&layer.slots, "broadcast profile slots").unwrap(),
+                    layer.slot_values
+                );
+            }
+        }
+
+        fn assert_exact(layers: &[ProfileLayer]) {
+            for layer in layers {
+                assert_eq!(
+                    logical_values(&layer.candidate)
+                        .iter()
+                        .map(|value| value.to_bits())
+                        .collect::<Vec<_>>(),
+                    logical_values(&layer.baseline)
+                        .iter()
+                        .map(|value| value.to_bits())
+                        .collect::<Vec<_>>(),
+                    "layer {} broadcast candidate differs",
+                    layer.layer
+                );
+            }
+        }
+
+        fn assert_weight_banks_unchanged(
+            disjoint: &[(ProfileBank, ProfileBank)],
+            warm: &(ProfileBank, ProfileBank),
+            phase: &str,
+        ) {
+            for (index, pair) in disjoint.iter().enumerate() {
+                pair.0
+                    .assert_unchanged(&format!("{phase} broadcast gate layer {index}"));
+                pair.1
+                    .assert_unchanged(&format!("{phase} broadcast up layer {index}"));
+            }
+            warm.0
+                .assert_unchanged(&format!("{phase} broadcast warm gate"));
+            warm.1
+                .assert_unchanged(&format!("{phase} broadcast warm up"));
+        }
+
+        fn sample(
+            ctx: &MetalContext,
+            layers: &[ProfileLayer],
+            disjoint: &[(ProfileBank, ProfileBank)],
+            warm: &(ProfileBank, ProfileBank),
+            arm: Arm,
+            regime: Regime,
+        ) -> Sample {
+            assert_eq!(layers.len(), disjoint.len());
+            let mut commands = Vec::with_capacity(layers.len());
+            let started = std::time::Instant::now();
+            let mut wall_ms = None;
+            for (index, (layer, pair)) in layers.iter().zip(disjoint).enumerate() {
+                let pair = match regime {
+                    Regime::Disjoint => pair,
+                    Regime::Warm => warm,
+                };
+                let command = ctx.queue.commandBuffer().unwrap();
+                let encoder = KernelEncoder::begin(&command);
+                let output = match arm {
+                    Arm::Baseline => &layer.baseline,
+                    Arm::Candidate => &layer.candidate,
+                };
+                let result = match arm {
+                    Arm::Baseline => encode_packed_grouped_swiglu_iq2_xs_f32(
+                        ctx,
+                        &encoder,
+                        &pair.0.tensor,
+                        &pair.1.tensor,
+                        &layer.input,
+                        &layer.slots,
+                        &layer.schedule,
+                        output,
+                        H,
+                        F,
+                        E,
+                        K,
+                        N,
+                        CLAMP,
+                    ),
+                    Arm::Candidate => encode_packed_grouped_swiglu_iq2_xs_broadcast_f32(
+                        ctx,
+                        &encoder,
+                        &pair.0.tensor,
+                        &pair.1.tensor,
+                        &layer.input,
+                        &layer.slots,
+                        &layer.schedule,
+                        output,
+                        H,
+                        F,
+                        E,
+                        K,
+                        N,
+                        CLAMP,
+                    ),
+                };
+                encoder.end();
+                result.unwrap();
+                command.commit();
+                command.waitUntilCompleted();
+                if index + 1 == layers.len() {
+                    wall_ms = Some(started.elapsed().as_secs_f64() * 1e3);
+                }
+                commands.push(command);
+            }
+            let wall_ms = wall_ms.unwrap();
+            let gpu_ms = commands
+                .iter()
+                .zip(layers)
+                .map(|(command, layer)| {
+                    assert!(
+                        command.error().is_none(),
+                        "layer {} {arm:?}: {:?}",
+                        layer.layer,
+                        command.error()
+                    );
+                    let start = command.GPUStartTime();
+                    let end = command.GPUEndTime();
+                    let gpu_ms = (end - start) * 1e3;
+                    assert!(
+                        start.is_finite()
+                            && start > 0.0
+                            && end.is_finite()
+                            && end > start
+                            && gpu_ms.is_finite()
+                            && gpu_ms > 0.0
+                    );
+                    gpu_ms
+                })
+                .sum::<f64>();
+            assert!(gpu_ms.is_finite() && gpu_ms > 0.0);
+            assert!(wall_ms.is_finite() && wall_ms > 0.0);
+            Sample { gpu_ms, wall_ms }
+        }
+
+        fn validate_regime(
+            ctx: &MetalContext,
+            layers: &[ProfileLayer],
+            disjoint: &[(ProfileBank, ProfileBank)],
+            warm: &(ProfileBank, ProfileBank),
+            regime: Regime,
