+        eprintln!(
+            "deepseek_v4 grouped_iq2_broadcast_packet route_payload_sha256={ROUTE_PAYLOAD_SHA256} encoder_source_sha256={encoder_source_sha256} kernel_source_sha256={kernel_source_sha256} clamp={CLAMP} samples_per_cell={SAMPLES} economic_floor_ms={ECONOMIC_FLOOR_MS} fractional_floor=0.25 v2_empty_bound_ms={V2_EMPTY_BOUND_MS} wall_is_diagnostic=true {disjoint_transcript} {warm_transcript} decision={decision} baseline_dispatches={} candidate_dispatches={} logical_bank_bytes={logical_bank_bytes} touched_weight_bytes={touched_weight_bytes} allocated_bytes={allocated_bytes} weight_digest={weight_digest} disjoint_baseline_digest={disjoint_baseline_digest} disjoint_candidate_digest={disjoint_candidate_digest} warm_baseline_digest={warm_baseline_digest} warm_candidate_digest={warm_candidate_digest}",
