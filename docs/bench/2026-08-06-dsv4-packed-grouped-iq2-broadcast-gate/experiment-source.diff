+            let _ = sample(ctx, layers, disjoint, warm, Arm::Baseline, regime);
+            let _ = sample(ctx, layers, disjoint, warm, Arm::Candidate, regime);
+            assert_eq!(output_digest(layers, Arm::Baseline), baseline_digest);
+            assert_eq!(output_digest(layers, Arm::Candidate), candidate_digest);
+            assert_exact(layers);
