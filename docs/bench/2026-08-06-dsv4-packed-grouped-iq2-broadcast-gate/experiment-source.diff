+        fn profile_bank(
+            ctx: &MetalContext,
+            initialized_experts: Vec<usize>,
+            seed: u64,
+            template: &[u8],
+            blocks_per_expert: usize,
+            block_bytes: usize,
+        ) -> ProfileBank {
+            assert!(!initialized_experts.is_empty());
+            assert!(
+                initialized_experts
+                    .windows(2)
+                    .all(|window| window[0] < window[1])
+            );
+            assert!(initialized_experts.iter().all(|&expert| expert < E));
+            let expert_bytes = template.len();
+            assert_eq!(expert_bytes, blocks_per_expert * block_bytes);
+            let bank_bytes = expert_bytes * E;
+            assert_eq!(bank_bytes, 620_756_992);
+            assert!(bank_bytes <= ctx.max_buffer_length());
+            let buffer = ctx.buffer_uninit(bank_bytes).unwrap();
+            let tensor = MetalTensor {
+                buffer,
+                offset: 0,
+                shape: vec![H as u64, F as u64, E as u64],
+                dtype: GgmlType::IQ2_XS,
+                provenance: MetalTensorProvenance::OwnedWritable,
+            };
+            let base = tensor.buffer.contents().as_ptr().cast::<u8>();
+            for &expert in &initialized_experts {
+                let destination = unsafe { base.add(expert * expert_bytes) };
+                unsafe {
+                    std::ptr::copy_nonoverlapping(template.as_ptr(), destination, expert_bytes);
+                }
+                for block in (0..blocks_per_expert).step_by(16) {
+                    let value = mix64(seed ^ ((expert as u64) << 32) ^ block as u64);
+                    unsafe {
+                        std::ptr::copy_nonoverlapping(
+                            value.to_le_bytes().as_ptr(),
+                            destination.add(block * block_bytes + 2),
+                            8,
+                        );
+                    }
+                }
+            }
+            let mut bank = ProfileBank {
+                tensor,
+                expert_bytes,
+                initialized_experts,
+                original_digest: [0; 32],
+            };
+            bank.original_digest = bank.digest();
+            bank
+        }
