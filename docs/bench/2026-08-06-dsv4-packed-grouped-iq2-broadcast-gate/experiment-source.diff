+                .schedule
+                .iter()
+                .map(|bucket| bucket.expert)
+                .collect::<Vec<_>>();
+            disjoint.push((
+                profile_bank(
+                    &ctx,
+                    experts.clone(),
+                    0x1000_0000 ^ layer.layer as u64,
+                    &template,
+                    blocks,
+                    block_bytes,
+                ),
+                profile_bank(
+                    &ctx,
+                    experts,
+                    0x2000_0000 ^ layer.layer as u64,
+                    &template,
+                    blocks,
+                    block_bytes,
+                ),
+            ));
+        }
+        let all_experts = (0..E).collect::<Vec<_>>();
+        let warm = (
+            profile_bank(
+                &ctx,
+                all_experts.clone(),
+                0x3000_0000,
+                &template,
+                blocks,
+                block_bytes,
+            ),
+            profile_bank(
+                &ctx,
+                all_experts,
+                0x4000_0000,
+                &template,
+                blocks,
+                block_bytes,
+            ),
+        );
+        let logical_bank_bytes = disjoint
+            .iter()
+            .map(|pair| pair.0.tensor.n_bytes() + pair.1.tensor.n_bytes())
+            .sum::<u64>()
+            .checked_add(warm.0.tensor.n_bytes() + warm.1.tensor.n_bytes())
+            .unwrap();
+        assert_eq!(logical_bank_bytes, 32_279_363_584);
+        let mut bank_refs = Vec::with_capacity(52);
+        for pair in &disjoint {
+            bank_refs.extend([&pair.0, &pair.1]);
+        }
+        bank_refs.extend([&warm.0, &warm.1]);
+        let touched_weight_bytes = bank_refs
+            .iter()
