+                        drift(baseline),
+                        drift(candidate),
+                    ),
+                )
+            };
+            let (gpu_pass, gpu) = metric("gpu", &baseline_gpu, &candidate_gpu, V2_EMPTY_BOUND_MS);
+            let (_wall_pass, wall) =
+                metric("wall_diagnostic", &baseline_wall, &candidate_wall, 0.0);
+            (
+                stable,
+                gpu_pass,
+                format!(
+                    "regime={regime:?} gpu_stable={stable} gpu_drifts={gpu_drifts:?} wall_drifts_diagnostic={wall_drifts:?} {gpu} {wall}"
+                ),
+            )
+        }
+
+        let ctx = MetalContext::new().expect("broadcast production-shape gate requires Metal");
+        assert_eq!(
+            ctx.device.name().to_string(),
+            PACKED_GROUPED_EXPERT_QUALIFIED_DEVICE
+        );
+        assert!(packed_grouped_expert_enabled_for_test(&ctx));
+        let encoder_source_sha256 = source_contract_sha256(
