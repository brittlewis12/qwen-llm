+        let kernel_source_sha256 = source_contract_sha256(
+            include_str!("../../../../kernels/mat_vec.metal"),
+            "kernel void kernel_deepseek_v4_packed_grouped_swiglu_iq2_xs_broadcast(",
+            "kernel void kernel_mat_mat_iq2_s_f32(",
+        );
+        assert_eq!(encoder_source_sha256, ENCODER_SOURCE_SHA256);
+        assert_eq!(kernel_source_sha256, KERNEL_SOURCE_SHA256);
+        let layers = profile_layers(&ctx);
+        let input_before = input_digest(&layers);
+        let (template, blocks, block_bytes) = expert_template();
+        let mut disjoint = Vec::with_capacity(layers.len());
