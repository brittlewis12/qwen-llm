+            let wall_drifts = [drift(&baseline_wall), drift(&candidate_wall)];
+            let stable = gpu_drifts.iter().all(|&value| value <= 0.05);
+            let metric = |name: &str, baseline: &[f64], candidate: &[f64], empty_bound: f64| {
