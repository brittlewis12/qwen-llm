+            (Arm::Baseline, Regime::Warm),
+            (Arm::Baseline, Regime::Warm),
+            (Arm::Candidate, Regime::Warm),
+            (Arm::Candidate, Regime::Disjoint),
+            (Arm::Baseline, Regime::Disjoint),
