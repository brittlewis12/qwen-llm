+        let mut baseline_disjoint = Vec::with_capacity(SAMPLES);
+        let mut candidate_disjoint = Vec::with_capacity(SAMPLES);
+        let mut baseline_warm = Vec::with_capacity(SAMPLES);
+        let mut candidate_warm = Vec::with_capacity(SAMPLES);
