#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""Run a command while holding qwen-llm's Metal process lease.

Usage: with-metal-lease [--lease-dir DIR] [--] COMMAND [ARGS...]

qwen-llm serializes timed GPU work with an exclusive flock on
/tmp/qwen-llm-$UID/metal.lock (crates/qwen-llm/src/metal/context.rs). Other
engines such as llama.cpp do not take it, so their runs and qwen runs can
overlap. This wrapper takes the same lease with the same checks, writes the
same owner record, then execs COMMAND with the locked descriptor inherited:
COMMAND keeps its PID and holds the lease until it exits.

A busy lease fails immediately (exit 75) unless QWEN_METAL_LEASE_WAIT is
1/true/yes, matching qwen. --lease-dir replaces the lease directory, for
tests only.

Under `uv run`, the PID a caller sees is uv's; uv forwards SIGINT and SIGTERM
to COMMAND and returns its exit status. The lease file records COMMAND's PID.
"""

import fcntl
import os
import stat
import sys

EX_TEMPFAIL = 75
WAIT_ENV = "QWEN_METAL_LEASE_WAIT"


def die(message: str, code: int = 1) -> None:
    print(f"with-metal-lease: {message}", file=sys.stderr)
    sys.exit(code)


def owner_field(value: str) -> str:
    # Same sanitizer as lease_owner_field.
    keep = set("-_./")
    return "".join(
        c if (c.isascii() and c.isalnum()) or c in keep else "_" for c in value
    )[:512]


def owner_display(value: str) -> str:
    # Same sanitizer as lease_owner_display.
    keep = set(" =-_./:")
    return "".join(
        c if (c.isascii() and c.isalnum()) or c in keep else "_" for c in value
    )[:512]


def secure_directory(directory: str, uid: int) -> None:
    try:
        st = os.lstat(directory)
        if not stat.S_ISDIR(st.st_mode) or st.st_uid != uid:
            die(f"lease directory {directory} is not a user-owned directory")
    except FileNotFoundError:
        os.makedirs(directory, exist_ok=True)
    os.chmod(directory, 0o700)
    st = os.lstat(directory)
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != uid or st.st_mode & 0o077:
        die(f"lease directory {directory} did not retain private ownership and mode")


def validate_lease(fd: int, path: str, uid: int) -> None:
    opened, linked = os.fstat(fd), os.lstat(path)
    if (
        not stat.S_ISREG(opened.st_mode)
        or not stat.S_ISREG(linked.st_mode)
        or opened.st_uid != uid
        or linked.st_uid != uid
        or opened.st_mode & 0o077
        or linked.st_mode & 0o077
        or opened.st_nlink != 1
        or (opened.st_dev, opened.st_ino) != (linked.st_dev, linked.st_ino)
    ):
        die(f"lease {path} is not one user-owned regular inode")


def read_owner(fd: int) -> str:
    try:
        os.lseek(fd, 0, os.SEEK_SET)
        text = os.read(fd, 4096).decode("utf-8", "replace").strip()
    except OSError:
        text = ""
    return owner_display(text) if text else "owner metadata unavailable"


def main(argv: list[str]) -> None:
    uid = os.geteuid()
    directory = f"/tmp/qwen-llm-{uid}"
    args = argv[1:]
    if args[:1] == ["--lease-dir"]:
        if len(args) < 2:
            die("--lease-dir needs a directory", 2)
        directory, args = args[1], args[2:]
    if args[:1] == ["--"]:
        args = args[1:]
    if not args or args[0] in ("-h", "--help"):
        print(__doc__.strip(), file=sys.stderr)
        sys.exit(0 if args else 2)

    secure_directory(directory, uid)
    path = os.path.join(directory, "metal.lock")
    fd = os.open(path, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
    os.fchmod(fd, 0o600)
    validate_lease(fd, path, uid)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        owner = read_owner(fd)
        if os.environ.get(WAIT_ENV) not in ("1", "true", "TRUE", "yes", "YES"):
            die(
                f"another qwen process owns {path} ({owner}); queue the work or set {WAIT_ENV}=1 to wait",
                EX_TEMPFAIL,
            )
        print(f"metal: waiting for process lease {path} ({owner})", file=sys.stderr)
        fcntl.flock(fd, fcntl.LOCK_EX)
    validate_lease(fd, path, uid)
    os.ftruncate(fd, 0)
    os.lseek(fd, 0, os.SEEK_SET)
    session = (
        owner_field(os.environ["OPENCODE_CALLER_SESSION_ID"])
        if "OPENCODE_CALLER_SESSION_ID" in os.environ
        else "none"
    )
    os.write(
        fd,
        f"pid={os.getpid()} executable={owner_field(os.path.basename(args[0]))} opencode_session={session}\n".encode(),
    )
    os.set_inheritable(fd, True)
    try:
        os.execvp(args[0], args)
    except OSError as error:
        die(f"exec {args[0]}: {error}", 127)


if __name__ == "__main__":
    main(sys.argv)
