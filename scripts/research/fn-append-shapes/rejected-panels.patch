diff --git b/crates/qwen-llm/src/metal/moe_grouped_generic/tensor.rs a/crates/qwen-llm/src/metal/moe_grouped_generic/tensor.rs
index 5c003881d..10d96cf1a 100644
--- b/crates/qwen-llm/src/metal/moe_grouped_generic/tensor.rs
+++ a/crates/qwen-llm/src/metal/moe_grouped_generic/tensor.rs
@@ -109,6 +109,184 @@ pub fn moe_grouped_tensor_selected(ctx: &MetalContext) -> bool {
 const TENSOR_THREADGROUP_BYTES: usize = 8192;
 const TENSOR_THREADGROUP_BYTES_WIDE: usize = 16384;
 
+/// FN-only 16/32-slot count ranges. All passes are preflighted before mutation.
+#[allow(clippy::too_many_arguments)]
+pub(crate) fn try_encode_fn_append_expert_panels(
+    ctx: &MetalContext,
+    enc: &KernelEncoder,
+    gate: &MetalTensor,
+    up: &MetalTensor,
+    input: &MetalTensor,
+    counts: &MetalTensor,
+    ids: &MetalTensor,
+    inner: &MetalTensor,
+    fused: bool,
+    h: usize,
+    f: usize,
+    e: usize,
+    top: usize,
+    rows: usize,
+) -> Result<bool, MetalError> {
+    use crate::metal::checks::{check_disjoint, require_serial};
+    const K: &str = "fn_append_expert_panels";
+    if !moe_grouped_tensor_selected(ctx)
+        || input.dtype != GgmlType::F32
+        || gate.dtype != up.dtype
+        || !(128..2048).contains(&rows)
+        || !matches!(
+            gate.dtype,
+            GgmlType::IQ2_S | GgmlType::IQ3_S | GgmlType::IQ3_XXS | GgmlType::IQ4_XS
+        )
+    {
+        return Ok(false);
+    }
+    require_serial(K, enc)?;
+    check_disjoint(
+        K,
+        inner,
+        &[
+            (gate, "gate"),
+            (up, "up"),
+            (input, "input"),
+            (counts, "counts"),
+            (ids, "ids"),
+        ],
+    )?;
+    let ga = generic_mm_args(
+        K, gate, input, counts, ids, inner, h, f, e, rows, top, 1, 16,
+    )?;
+    let ua = generic_mm_args(K, up, input, counts, ids, inner, h, f, e, rows, top, 1, 16)?;
+    let suffix = moe_grouped_generic_layout(gate.dtype).unwrap().suffix;
+    let names = if fused {
+        vec![
+            format!("kernel_fn_moe_gate_up_{suffix}_panel16"),
+            moe_grouped_tensor_pipeline_name(
+                MoeGroupedTensorRole::Down,
+                gate.dtype,
+                TensorActivation::F32,
+            )
+            .unwrap(),
+            moe_grouped_tensor_pipeline_name(
+                MoeGroupedTensorRole::UpSiluMul,
+                up.dtype,
+                TensorActivation::F32,
+            )
+            .unwrap(),
+        ]
+    } else {
+        vec![
+            format!("kernel_fn_moe_down_{suffix}_panel16"),
+            moe_grouped_tensor_pipeline_name(
+                MoeGroupedTensorRole::Down,
+                gate.dtype,
+                TensorActivation::F32,
+            )
+            .unwrap(),
+            format!("kernel_fn_moe_up_{suffix}_panel16"),
+            moe_grouped_tensor_pipeline_name(
+                MoeGroupedTensorRole::UpSiluMul,
+                up.dtype,
+                TensorActivation::F32,
+            )
+            .unwrap(),
+        ]
+    };
+    let mut psos = Vec::new();
+    for (index, name) in names.into_iter().enumerate() {
+        let p = match ctx.tensor_pipeline(&name) {
+            Ok(p) => p,
+            Err(MetalError::NoFunction(_) | MetalError::Pipeline(_, _)) => return Ok(false),
+            Err(e) => return Err(e),
+        };
+        if p.threadExecutionWidth() != 32
+            || p.maxTotalThreadsPerThreadgroup() < 128
+            || p.staticThreadgroupMemoryLength()
+                + if fused && index == 0 {
+                    9216
+                } else {
+                    TENSOR_THREADGROUP_BYTES
+                }
+                > ctx.device.maxThreadgroupMemoryLength()
+        {
+            return Ok(false);
+        }
+        psos.push(p);
+    }
+    for (index, p) in psos.into_iter().enumerate() {
+        if fused && index == 0 {
+            enc.set_pipeline(&p);
+            enc.set_bytes(0, &ga);
+            for (slot, t) in [
+                (1, gate),
+                (2, up),
+                (3, input),
+                (4, counts),
+                (5, ids),
+                (6, inner),
+            ] {
+                enc.set_tensor(slot, t);
+            }
+            enc.set_threadgroup_memory(0, 9216);
+            enc.dispatch(
+                MTLSize {
+                    width: 1,
+                    height: f.div_ceil(64),
+                    depth: e,
+                },
+                MTLSize {
+                    width: 128,
+                    height: 1,
+                    depth: 1,
+                },
+            );
+            continue;
+        }
+        let gate_role = if fused { index == 1 } else { index < 2 };
+        let mut a = if gate_role { ga } else { ua };
+        let panel = if !fused && index % 2 == 0 { 16 } else { 32 };
+        if panel == 32 {
+            a.min_count = 17;
+            a.max_count = i32::MAX as u32;
+        }
+        enc.set_pipeline(&p);
+        enc.set_bytes(0, &a);
+        for (slot, t) in [
+            (1, if gate_role { gate } else { up }),
+            (2, input),
+            (3, counts),
+            (4, ids),
+            (5, inner),
+        ] {
+            enc.set_tensor(slot, t);
+        }
+        // Weight slab 64*32*2 plus live activation slab PANEL*32*2;
+        // the 16-slot F32 output (4096 bytes) fits in the same storage.
+        enc.set_threadgroup_memory(
+            0,
+            if panel == 16 {
+                5120
+            } else {
+                TENSOR_THREADGROUP_BYTES
+            },
+        );
+        enc.dispatch(
+            MTLSize {
+                // This pass only accepts counts <=16: there is exactly one
+                // live tile per expert. Do not launch rows/16 empty tiles.
+                width: if panel == 16 { 1 } else { rows.div_ceil(panel) },
+                height: f.div_ceil(64),
+                depth: e,
+            },
+            MTLSize {
+                width: 128,
+                height: 1,
+                depth: 1,
+            },
+        );
+    }
+    Ok(true)
+}
