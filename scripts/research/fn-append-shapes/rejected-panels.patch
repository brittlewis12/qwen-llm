@@ -0,0 +1,57 @@
+use super::*;
+
+crate::env_flag!(
+    /// Experimental Flash-Next append expert panels: 16 slots for buckets through 16 entries, 32 otherwise, at 128..2047 rows with QWEN_FN_APPEND_SHAPES. Same native quantization, half operands and F32 accumulators; no new buffers. Zero keeps the original 32-slot tile, and 2048-row/decode/other-family policies stay unchanged.
+    default_off enabled,
+    "QWEN_FN_APPEND_EXPERT_PANELS"
+);
+
+crate::env_flag!(
+    /// Experimental shared-staging gate/up fusion for <=16-slot buckets under QWEN_FN_APPEND_EXPERT_PANELS: one 9-KiB tile stages both weights and the shared activation, halving per-K barriers. Larger buckets retain two 32-slot passes. Same half values, F32 sums and K traversal, no new buffers. Zero uses separate 16/32 count-range passes.
+    default_off fused,
+    "QWEN_FN_APPEND_PANEL_FUSED"
+);
+
+pub(super) fn try_encode(
+    ctx: &MetalContext,
+    enc: &KernelEncoder,
+    gate: &MetalTensor,
+    up: &MetalTensor,
+    input: &MetalTensor,
+    counts: &MetalTensor,
+    ids: &MetalTensor,
+    inner: &MetalTensor,
+    g: Qwen4ExpMoeMetalGeometry,
+    tokens: usize,
+) -> Result<bool, MetalError> {
+    if !enabled()
+        || !crate::qwen4exp_prefill_tensor::shapes::selected(tokens)
+        || tokens == 2048
+        || (
+            g.hidden_size,
+            g.routed_intermediate_size,
+            g.expert_count,
+            g.experts_per_token,
+        ) != (2560, 640, 512, 10)
+        || gate.dtype != up.dtype
+        || !ROUTED_GATE_UP_DTYPES.contains(&gate.dtype)
+    {
+        return Ok(false);
+    }
+    crate::metal::try_encode_fn_append_expert_panels(
+        ctx,
+        enc,
+        gate,
+        up,
+        input,
+        counts,
+        ids,
+        inner,
+        fused(),
+        g.hidden_size,
+        g.routed_intermediate_size,
+        g.expert_count,
+        g.experts_per_token,
+        tokens,
+    )
+}
