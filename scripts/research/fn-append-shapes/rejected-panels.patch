@@ -0,0 +1,133 @@
+use super::*;
+
+#[test]
+fn fn_append_panels_preserve_values_bounds_and_operand_error() {
+    let Some(ctx) = metal_test_context() else {
+        return;
+    };
+    if !moe_grouped_tensor_available(&ctx) {
+        return;
+    }
+    let (h, f, e, top, rows) = (256usize, 128usize, 32usize, 2usize, 128usize);
+    let slots = rows * top;
+    let assignments: Vec<usize> = (0..rows)
+        .flat_map(|t| {
+            [
+                if t < 65 { 0 } else { 4 + t % 24 },
+                if t < 16 {
+                    2
+                } else if t < 33 {
+                    1
+                } else if t == 33 {
+                    3
+                } else {
+                    4 + (t + 7) % 24
+                },
+            ]
+        })
+        .collect();
+    let mut counts = vec![0i32; e];
+    let mut ids = vec![-1i32; e * rows];
+    for (slot, &expert) in assignments.iter().enumerate() {
+        ids[expert * rows + counts[expert] as usize] = slot as i32;
+        counts[expert] += 1;
+    }
+    assert_eq!(&counts[..4], &[65, 17, 16, 1]);
+    let ct = i32_typed_tensor(&ctx, &counts);
+    let it = i32_typed_tensor(&ctx, &ids);
+    for dtype in [
+        GgmlType::IQ2_S,
+        GgmlType::IQ3_S,
+        GgmlType::IQ3_XXS,
+        GgmlType::IQ4_XS,
+    ] {
+        let gb = synthetic_bank(dtype, h, f, e, 0x9911 ^ dtype as u64);
+        let ub = synthetic_bank(dtype, h, f, e, 0x2a77 ^ dtype as u64);
+        let g = bank_tensor(&ctx, dtype, &gb, h, f, e);
+        let u = bank_tensor(&ctx, dtype, &ub, h, f, e);
+        let x: Vec<f32> = (0..h * rows)
+            .map(|i| ((i * 37 + 7) % 1009) as f32 / 1009.0 - 0.5)
+            .collect();
+        let xt = f32_tensor(&ctx, &x);
+        let guarded = || {
+            offset_tensor(
+                &ctx,
+                16,
+                bytemuck::cast_slice(&vec![f32::NAN; slots * f]),
+                16,
+                vec![(slots * f) as u64],
+                GgmlType::F32,
+            )
+        };
+        let a = guarded();
+        let b = guarded();
+        let c = guarded();
+        one_shot(&ctx, |enc| {
+            encode_moe_swiglu_f32_grouped_slots_tensor(
+                &ctx, enc, &g, &u, &xt, &ct, &it, &a, h, f, e, top, rows, None,
+            )?;
+            assert!(try_encode_fn_append_expert_panels(
+                &ctx, enc, &g, &u, &xt, &ct, &it, &b, false, h, f, e, top, rows
+            )?);
+            assert!(try_encode_fn_append_expert_panels(
+                &ctx, enc, &g, &u, &xt, &ct, &it, &c, true, h, f, e, top, rows
+            )?);
+            Ok(())
+        })
+        .unwrap();
+        let av = tensor_f32_at_offset(&a);
+        let bv = tensor_f32_at_offset(&b);
+        let cv = tensor_f32_at_offset(&c);
+        assert!(av.iter().chain(&bv).chain(&cv).all(|v| v.is_finite()));
+        let mut errors = [0f64; 3];
+        let mut maxima = [0f64; 3];
+        let gate: Vec<_> = (0..e).map(|i| cpu_expert(dtype, &gb, h, f, i)).collect();
+        let up: Vec<_> = (0..e).map(|i| cpu_expert(dtype, &ub, h, f, i)).collect();
+        for sample in 0..128 {
+            let slot = sample * (slots - 1) / 127;
+            let col = sample * 7919 % f;
+            let expert = assignments[slot];
+            let mut gv = 0f64;
+            let mut uv = 0f64;
+            for j in 0..h {
+                let input = f64::from(half::f16::from_f32(x[slot / top * h + j]).to_f32());
+                gv += f64::from(half::f16::from_f32(gate[expert][col * h + j]).to_f32()) * input;
+                uv += f64::from(half::f16::from_f32(up[expert][col * h + j]).to_f32()) * input;
+            }
+            let reference = gv / (1. + (-gv).exp()) * uv;
+            for (arm, v) in [av[slot * f + col], bv[slot * f + col], cv[slot * f + col]]
+                .into_iter()
+                .enumerate()
+            {
+                let error = (f64::from(v) - reference).abs();
+                errors[arm] += error * error;
+                maxima[arm] = maxima[arm].max(error);
+            }
+        }
+        for arm in 1..=2 {
+            assert!(errors[arm] <= errors[0], "{dtype:?} SSE {errors:?}");
+            assert!(maxima[arm] <= maxima[0], "{dtype:?} max {maxima:?}");
+        }
+        assert_offset_guards(&a, 16, 16);
+        assert_offset_guards(&b, 16, 16);
+        assert_offset_guards(&c, 16, 16);
+        eprintln!(
+            "APPEND_PANEL_F64 dtype={dtype:?} SSE={errors:?} max={maxima:?} bitwise={}",
+            bytemuck::cast_slice::<f32, u8>(&av) == bytemuck::cast_slice::<f32, u8>(&bv)
+        );
+        let cmd = ctx.queue.commandBuffer().unwrap();
+        let enc = KernelEncoder::begin(&cmd);
+        crate::metal::dispatch_census_begin();
+        let alias = xt.view_subrange(0, vec![(h * rows) as u64]);
+        assert!(
+            try_encode_fn_append_expert_panels(
+                &ctx, &enc, &g, &u, &xt, &ct, &it, &alias, true, h, f, e, top, rows
+            )
+            .is_err()
+        );
+        assert!(crate::metal::dispatch_census_take().is_empty());
+        enc.end();
+        cmd.commit();
+        wait_completed(&cmd).unwrap();
+    }
+}
