+// Small buckets share one activation and stage both weight slabs. Two barriers
+// per K step instead of four across independent gate/up kernels. All physical
+// fragments consumed by either matmul are initialized, including slot tails.
+template<int BYTES, short NL, void (*DEQ)(device const uchar*,short,thread half4x4&)>
+kernel void kernel_fn_gate_up_panel16(
+        constant moe_group_generic_mm_args&a [[buffer(0)]],
+        device const uchar*gw [[buffer(1)]],device const uchar*uw [[buffer(2)]],
+        device const float*x [[buffer(3)]],device const int*counts [[buffer(4)]],
+        device const int*ids [[buffer(5)]],device float*dst [[buffer(6)]],
+        threadgroup uchar*storage [[threadgroup(0)]],
+        uint3 group [[threadgroup_position_in_grid]],uint tid [[thread_index_in_threadgroup]]) {
+    const int e=group.z,count=counts[e],r0=group.y*64;
